{
  "name": "@meeting-stt/api",
  "version": "0.0.0",
  "private": true,
  "description": "Knot prototype local-first Fastify API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_PG_INTEGRATION=1 vitest run src/server.integration.test.ts",
    "db:migrate": "tsx src/migrate.ts",
    "verify:backup-restore": "tsx scripts/verifyBackupRestore.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@meeting-stt/prototype-contracts": "workspace:*",
    "fastify": "^5.6.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.23.12"
  }
}
