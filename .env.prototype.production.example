# Knot prototype EC2 production example.
# Copy to .env.prototype.production on the EC2 host and replace every placeholder.
# Do not commit the real .env.prototype.production file.

KNOT_API_DOMAIN=api.example.com
KNOT_API_IMAGE=registry.example.invalid/knot/meeting-stt-api:replace-with-arm64-tag

POSTGRES_PASSWORD=replace-with-long-random-migrator-password
API_RUNTIME_DB_PASSWORD=replace-with-long-random-runtime-password

GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret

STORAGE_DRIVER=s3
AWS_REGION=ap-northeast-2
S3_BUCKET=your-private-bucket
S3_PREFIX=knot/prototype-private/recordings
# Operator assertions: keep both false until one access mode is deliberately chosen.
# Set S3_PRIVATE_PREFIX_CONFIRMED=true only after the prefix is confirmed private.
# Set S3_PUBLIC_READ_ACKNOWLEDGED=true only for the prototype mode where uploaded recordings,
# transcripts, and AI summaries may be publicly readable.
S3_PRIVATE_PREFIX_CONFIRMED=false
S3_PUBLIC_READ_ACKNOWLEDGED=false

JSON_BODY_LIMIT_BYTES=33554432
MAX_UPLOAD_BYTES=1073741824
